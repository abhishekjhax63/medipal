# ---------------------------------------------------------------------
# MEDIPAL · server (secret) environment — example
#
# Copy to `.env.server` and fill in. These values are read ONLY by `server/`
# and are never sent to the browser. Do not put any of these in `.env`.
# ---------------------------------------------------------------------

PORT=8787

# AI Doctor chat-completions provider (OpenAI-compatible). Example shown for a
# Bluesminds-hosted Google model; any OpenAI-compatible endpoint works.
AI_BASE_URL=
AI_API_KEY=sk-0UboDbuOd9jrvj1SZcx27eVSkVzXgFPfAUfLI1zal870Vufi
AI_MODEL=openai/gpt-oss-20b

# Enable only after verifying that the selected model accepts OpenAI-compatible
# `image_url` messages. Video is decoded into a bounded set of temporary frames
# with FFmpeg; it never claims to analyse every moment. Leave false until that
# provider capability and the server binaries are available.
AI_SUPPORTS_IMAGES=false
AI_SUPPORTS_VIDEO_FRAMES=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Razorpay: the key id is publishable (also set in `.env`), the secret is not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Geoapify: maps, geocoding and nearby blood-service facility search.
GEOAPIFY_API_KEY=

# PostgreSQL — Blood Bank module. The server deliberately connects as the
# least-privilege role `medipal_api` (never as a superuser) so that the
# FORCE ROW LEVEL SECURITY policies on donor/request data actually apply.
# `npm run db:setup` creates the role and applies db/migrations/*.sql.
DATABASE_ADMIN_URL=postgresql://<superuser>@127.0.0.1:5432/medipal
DATABASE_URL=postgresql://medipal_api:<generated-password>@127.0.0.1:5432/medipal

# Platform-admin key for the Blood Bank network console. Unset => the console
# reports `not_configured` and refuses to operate.
BLOOD_ADMIN_KEY=

# ---------------------------------------------------------------------
# Bihar live availability sync (§5, §6, §19, §21)
# ---------------------------------------------------------------------
# MEDIPAL stores blood data in its own PostgreSQL database (DATABASE_URL /
# DATABASE_ADMIN_URL above), NOT in Supabase — this deployment already runs
# migrations, least-privilege roles and FORCE ROW LEVEL SECURITY against
# PostgreSQL, so there are no SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY values.
# Every threshold below has a working default; set one only to override it.

# How often the scheduler synchronises availability. Default 15 minutes.
BLOOD_SYNC_INTERVAL_MINUTES=15

# Freshness ladder, in minutes, measured from the SOURCE's own observation
# time (`source_updated_at`) — never from when MEDIPAL wrote the row.
#   <= 30      LIVE      0-30 min
#   <= 120     RECENT    30-120 min
#   <= 360     STALE     2-6 h
#   >  360     OUTDATED  6 h+
# An old figure is never labelled LIVE.
BLOOD_LIVE_THRESHOLD_MINUTES=30
BLOOD_RECENT_THRESHOLD_MINUTES=120
BLOOD_STALE_THRESHOLD_MINUTES=360

# Used ONLY when a provider reports plain units and no status of its own. When
# a provider states a status, that status is copied verbatim instead of being
# re-derived from this number.
BLOOD_LOW_UNITS_THRESHOLD=3

# Source health: no successful sync for this long => DEGRADED, then OFFLINE.
# Existing inventory is never deleted when a source goes quiet (§10).
BLOOD_PROVIDER_DEGRADED_MINUTES=60
BLOOD_PROVIDER_OFFLINE_MINUTES=360

# Retry policy for provider HTTP calls (exponential backoff, honours 429
# Retry-After). Never a hot loop.
BLOOD_PROVIDER_ATTEMPTS=3
BLOOD_PROVIDER_BACKOFF_MS=700
BLOOD_PROVIDER_TIMEOUT_MS=12000

# Record cap per run, so a runaway provider cannot exhaust memory.
BLOOD_SYNC_MAX_RECORDS=20000

# ---------------------------------------------------------------------
# e-RaktKosh — AUTHORISED feed only (§2, §3, §21, §30)
# ---------------------------------------------------------------------
# LEAVE EVERY VALUE BELOW EMPTY unless C-DAC / MoHFW has issued you
# authorised e-RaktKosh "Open API" credentials. MEDIPAL does NOT scrape the
# portal, does NOT reverse-engineer a private API, does NOT bypass CAPTCHA or
# rate limiting, and does NOT invent a key, an endpoint or a stock figure.
# With these unset, `GET /api/blood/health` reports `not_configured` and the
# provider adapter is never called — an unconfigured probe must never become an
# unauthorised access attempt.
#
# The path variables are required because the issued credentials decide them.
# MEDIPAL never guesses an endpoint.
ERAKTKOSH_API_BASE_URL=
ERAKTKOSH_API_KEY=
ERAKTKOSH_API_SECRET=
ERAKTKOSH_CENTRES_PATH=
ERAKTKOSH_AVAILABILITY_PATH=
ERAKTKOSH_DISTRICTS_PATH=
# How the issued credentials expect to be presented. Defaults shown.
ERAKTKOSH_AUTH_HEADER=Authorization
ERAKTKOSH_AUTH_SCHEME=Bearer

# E-UPCHAR identity gateway. Configure this only in the service that validates
# real Google/email/phone sessions; it signs x-medipal-user-id + timestamp with
# HMAC-SHA256 before proxying a protected E-UPCHAR request. Never expose this
# in the browser or use it as a client API key.
EUPCHAR_AUTH_GATEWAY_SECRET=
