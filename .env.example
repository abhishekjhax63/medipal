# ---------------------------------------------------------------------
# MEDIPAL · frontend (public) environment — example
#
# Copy to `.env`. Everything here is compiled into the browser bundle, so only
# publishable / non-secret values belong in this file.
#
# Two rules, both non-negotiable:
#   1. Anything prefixed `VITE_` is public. Never put a secret here.
#   2. An integration whose value is missing must report `not_configured` /
#      `demo`. The UI then shows an honest unavailable state instead of
#      pretending the feature works.
#
# The real secrets (AI provider key, Razorpay secret, Geoapify key) live in
# `.env.server` — see `.env.server.example`.
# ---------------------------------------------------------------------

# Base URL of the E-UPCHAR backend. `same-origin` means "the server that served
# this page" (relative `/api/...`). Leave empty to run entirely against the
# local in-memory repository with Practice mode available.
VITE_EUPCHAR_API_BASE=same-origin

# Same-origin endpoint the AI Doctor posts conversations to. The provider key
# must live on the server that serves this route — NEVER here. If the backend
# is not configured, upload and analysis show a clear unavailable error; the
# application never substitutes a generated demonstration medical response.
VITE_MEDIPAL_AI_ENDPOINT=/api/ai/chat

# Razorpay *publishable* key id. The matching key secret must live only on the
# server that creates and verifies orders. With this set together with
# VITE_EUPCHAR_API_BASE, payments report `live`.
VITE_EUPCHAR_RAZORPAY_KEY_ID=
